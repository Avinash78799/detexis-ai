# Local default is NOT a production password. Use a long random hex value.
POSTGRES_PASSWORD=local-dev-only
# Database cache, not a total memory cap. Size for your host and measure it.
POSTGRES_SHARED_BUFFERS=512MB
# Separate Shield backend hostname; leave unset for localhost-only development.
SHIELD_DOMAIN=
# Optional per-site destinations; quote JSON as needed for your env loader.
# SHIELD_ALERT_TARGETS={"site-uuid":{"email":"owner@example.com","slack":"https://hooks.slack.com/services/...","telegram":"123456"}}
SHIELD_ALERT_TARGETS=
SMTP_HOST=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
